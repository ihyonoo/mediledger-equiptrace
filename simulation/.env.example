# simulation/.env — 로컬 개발용. 실제 값으로 채운 뒤 simulation/.env로 저장한다(gitignore됨).
# 홈서버 컨테이너에서는 이 파일 없이 docker-compose의 env_file/environment로 주입된다.

# 로컬 백엔드(uvicorn backend.server:app)를 가리킨다.
BACKEND_BASE_URL=http://127.0.0.1:8000

# 로컬 dev DB. 루트 .env의 DATABASE_URL과 동일한 값이면 된다.
DATABASE_URL=postgresql://mediledger:mediledger@localhost:5432/mediledger_db

# 필수. 시뮬레이션 staff 계정 5개가 공통으로 쓰는 로그인 비밀번호.
SIM_STAFF_PASSWORD=

# 아래는 전부 선택 — 기본값은 simulation/config.py 참고. 속도/활동량 튜닝용.
# POSITION_TICK_SEC=3
# ROOM_DWELL_MIN_SEC=20
# ROOM_DWELL_MAX_SEC=90
# RSSI_MIN=-70
# RSSI_MAX=-45
# READER_OUTAGE_PROBABILITY_PER_TICK=0.003
# READER_OUTAGE_MIN_SEC=15
# READER_OUTAGE_MAX_SEC=60
# TAG_STALE_PROBABILITY_PER_TICK=0.002
# TAG_STALE_MIN_SEC=6
# TAG_STALE_MAX_SEC=20
# CHECKOUT_CHECK_INTERVAL_SEC=15
# BASE_CHECKOUT_PROBABILITY_PER_TICK=0.02
# SIM_ACTIVITY_SCALE=1.0
# USAGE_DURATION_MIN_SEC=300
# USAGE_DURATION_MAX_SEC=2700
# RETURN_HTTP_TIMEOUT_SEC=40
