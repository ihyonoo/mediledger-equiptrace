# ── DB ──
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://mediledger:change-me-strong@postgres:5432/mediledger_db

# ── Redis (besu compose의 redis 서비스) ──
REDIS_URL=redis://redis:6379/0

# ── Auth ──
AUTH_TOKEN_SECRET=REPLACE-WITH-STRONG-RANDOM   # openssl rand -hex 32
AUTH_TOKEN_TTL_SEC=43200

# ── 공개 URL / CORS ──
APP_PUBLIC_URL=https://mediledger.xyz
CORS_ALLOW_ORIGINS=https://mediledger.xyz

# ── Gmail SMTP (실제 값, 서버에서만) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Google OAuth (실제 값, 서버에서만) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mediledger.xyz/auth/google/callback

# ── Cloudflare Tunnel ──
CLOUDFLARE_TUNNEL_TOKEN=

# ── Besu ──
BESU_RPC_URL=http://besu-rpc-node:8545

# ── simulator (simulation/) ──
# 시뮬레이션 staff 계정 5개가 공통으로 쓰는 로그인 비밀번호. 없으면 simulator 컨테이너가 즉시 종료된다.
SIM_STAFF_PASSWORD=change-me-strong
